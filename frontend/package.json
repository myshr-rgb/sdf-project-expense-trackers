  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.7.0",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
